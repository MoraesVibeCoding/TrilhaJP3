{
  "name": "trilhajp3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:floor": "node scripts/floor-guard.mjs --base origin/main",
    "check:secrets": "gitleaks detect --baseline-path gitleaks-baseline.json --redact --no-banner",
    "check:fast": "npm run typecheck && npm run lint && npm run check:floor && npm run check:secrets",
    "check:task": "npm run check:fast && vitest run --coverage && node scripts/coverage-changed.mjs",
    "check:full": "npm run check:task && npm run format:check && playwright test e2e/accessibility.spec.ts && npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
