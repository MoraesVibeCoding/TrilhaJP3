{
  "brand": "Moraes CodeVibe",
  "color": {
    "ink":      { "hex": "#16241A", "rgb": "22, 36, 26",   "role": "texto principal" },
    "forest":   { "hex": "#2B4A30", "rgb": "43, 74, 48",   "role": "primária / autoridade" },
    "leaf":     { "hex": "#6F9959", "rgb": "111, 153, 89", "role": "ação / energia" },
    "leafSoft": { "hex": "#A8C69A", "rgb": "168, 198, 154","role": "suporte / broto" },
    "mint":     { "hex": "#EEF3E8", "rgb": "238, 243, 232","role": "superfície clara" },
    "paper":    { "hex": "#F9FAF6", "rgb": "249, 250, 246","role": "fundo padrão" },
    "gold":     { "hex": "#B9843F", "rgb": "185, 132, 63", "role": "acento único (fora da família verde)" },
    "stone":    { "hex": "#7C8A76", "rgb": "124, 138, 118","role": "texto secundário" },
    "line":     { "hex": "#D8E0D0", "rgb": "216, 224, 208","role": "bordas / divisores" }
  },
  "typography": {
    "display": { "family": "Fraunces", "fallback": "Georgia, serif", "googleFonts": "Fraunces:ital,wght@0,500;0,600;0,800;1,500", "use": "títulos, headlines" },
    "body":    { "family": "Inter", "fallback": "system-ui, sans-serif", "googleFonts": "Inter:wght@400;500;600", "use": "corpo de texto, UI" },
    "mono":    { "family": "JetBrains Mono", "fallback": "ui-monospace, monospace", "googleFonts": "JetBrains+Mono:wght@400;500;600", "use": "detalhes técnicos, labels" }
  },
  "logo": {
    "icon": "logo/icon.svg",
    "iconMonoForest": "logo/icon-mono-forest.svg",
    "iconMonoWhite": "logo/icon-mono-white.svg",
    "lockupHorizontalOnWhite": "logo/lockup-horizontal-on-white.png",
    "lockupHorizontalOnForest": "logo/lockup-horizontal-on-forest.png",
    "lockupStackedOnWhite": "logo/lockup-stacked-on-white.png",
    "lockupStackedOnForest": "logo/lockup-stacked-on-forest.png",
    "clearSpaceRule": "área de respiro mínima em todos os lados = altura do ícone"
  },
  "contact": {
    "email": "contato@exemplo.com.br",
    "phone": "+55 (00) 0 0000-0000"
  }
}
