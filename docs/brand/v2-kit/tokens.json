{
  "color": {
    "tinta": {
      "$type": "color",
      "$value": "#0F1F14"
    },
    "floresta": {
      "$type": "color",
      "$value": "#1B4D2E"
    },
    "folha": {
      "$type": "color",
      "$value": "#2F7D4B"
    },
    "pulso": {
      "$type": "color",
      "$value": "#A6F26B"
    },
    "neblina": {
      "$type": "color",
      "$value": "#EDF4E7"
    },
    "papel": {
      "$type": "color",
      "$value": "#F8FAF5"
    },
    "ambar": {
      "$type": "color",
      "$value": "#D4892A"
    },
    "salvia": {
      "$type": "color",
      "$value": "#B4C5AF"
    },
    "salvia-clara": {
      "$type": "color",
      "$value": "#C9DBC3"
    },
    "cinza": {
      "$type": "color",
      "$value": "#526350"
    },
    "borda": {
      "$type": "color",
      "$value": "#D5DFCC"
    }
  },
  "semantic": {
    "bg": {
      "$type": "color",
      "$value": "{color.papel}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.neblina}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.tinta}"
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.cinza}"
    },
    "heading": {
      "$type": "color",
      "$value": "{color.floresta}"
    },
    "link": {
      "$type": "color",
      "$value": "{color.folha}"
    },
    "action": {
      "$type": "color",
      "$value": "{color.floresta}"
    },
    "action-text": {
      "$type": "color",
      "$value": "{color.neblina}"
    },
    "action-secondary": {
      "$type": "color",
      "$value": "{color.ambar}"
    },
    "ai-active": {
      "$type": "color",
      "$value": "{color.pulso}"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces",
        "Georgia",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "10px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    }
  }
}